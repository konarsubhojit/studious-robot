#!/usr/bin/env bash
set -euo pipefail

# Configuration variables understood by this script.  They must survive the
# self-elevation below: `env PATH="$PATH"` alone would silently drop them.
DEPLOY_VARS=(
  REPO_DIR
  DEPLOY_BRANCH
  SERVICE_NAME
  PM2_ECOSYSTEM
  SERVER_DIR
  PORTS
  HEALTH_PATH
  MAX_ATTEMPTS
  SLEEP_SECONDS
)

if [ "$(id -un)" != wetalk ]; then
  # Forward only the documented variables (an explicit environment, unlike
  # `sudo -E`) plus a known-good PATH.
  forwarded=()
  for deploy_var in "${DEPLOY_VARS[@]}"; do
    if [ -n "${!deploy_var+x}" ]; then
      forwarded+=("${deploy_var}=${!deploy_var}")
    fi
  done
  exec sudo -u wetalk -H env PATH="$PATH" ${forwarded[@]+"${forwarded[@]}"} "$0" "$@"
fi
cd /tmp

REPO_DIR="${REPO_DIR:-/home/wetalk/repos/studious-robot}"
DEPLOY_BRANCH="${DEPLOY_BRANCH:-master}"
SERVICE_NAME="${SERVICE_NAME:-robot-signal}"
PM2_ECOSYSTEM="${PM2_ECOSYSTEM:-$REPO_DIR/deploy/ecosystem.config.js}"
SERVER_DIR="${SERVER_DIR:-$REPO_DIR/server}"
PORTS="${PORTS:-4173 4174 4175 4176 4177 4178}"
HEALTH_PATH="${HEALTH_PATH:-/health}"
MAX_ATTEMPTS="${MAX_ATTEMPTS:-60}"
SLEEP_SECONDS="${SLEEP_SECONDS:-2}"
ENV_FILE=/etc/robot-signal/env

echo "[deploy] user=$(id -un) repo=${REPO_DIR} branch=${DEPLOY_BRANCH}"

if [[ ! -d "${REPO_DIR}/.git" ]]; then
  echo "[deploy] ERROR: no git checkout at ${REPO_DIR}" >&2
  exit 1
fi

on_failure() {
  local rc=$?
  echo "[deploy] ERROR: deploy failed with exit code ${rc}" >&2
  pm2 ls || true
  pm2 logs "${SERVICE_NAME}" --lines 200 --nostream || true
  exit "${rc}"
}
trap on_failure ERR

cd "${REPO_DIR}"
git fetch --quiet origin "${DEPLOY_BRANCH}"

# The lockfile revision before the reset decides whether dependencies changed.
# It is absent on a first deploy (or after a rename), which forces an install.
LOCKFILE_REL="server/package-lock.json"
case "${SERVER_DIR}" in
  "${REPO_DIR}"/*) LOCKFILE_REL="${SERVER_DIR#"${REPO_DIR}"/}/package-lock.json" ;;
esac
lockfile_before="$(git rev-parse --quiet --verify "HEAD:${LOCKFILE_REL}" 2>/dev/null || true)"

git reset --hard "origin/${DEPLOY_BRANCH}"

lockfile_after="$(git rev-parse --quiet --verify "HEAD:${LOCKFILE_REL}" 2>/dev/null || true)"

if command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
  sudo chown -R wetalk:wetalk "${REPO_DIR}"
else
  chown -R wetalk:wetalk "${REPO_DIR}" 2>/dev/null || true
fi

cd "${SERVER_DIR}"
if [[ ! -d node_modules ]]; then
  echo "[deploy] node_modules missing; installing dependencies"
  npm ci --omit=dev --no-audit --no-fund
elif [[ -z "${lockfile_before}" || "${lockfile_before}" != "${lockfile_after}" ]]; then
  echo "[deploy] lockfile changed; installing dependencies"
  npm ci --omit=dev --no-audit --no-fund
else
  echo "[deploy] lockfile unchanged; skipping install"
fi

# Non-fatal schema drift check.  It needs the server directory and a database
# URL from the (secret) env file, so it runs in a subshell whose environment is
# never echoed.  drizzle-kit is a dev dependency and is intentionally absent
# from the VM's production install; migrations run from CI, never from here.
schema_check() {
  (
    set +e
    set -a
    # shellcheck disable=SC1090
    [ -r "${ENV_FILE}" ] && . "${ENV_FILE}"
    set +a
    cd "${SERVER_DIR}" || exit 3
    [ -x node_modules/.bin/drizzle-kit ] || exit 4
    [ -n "${DATABASE_URL_DIRECT:-${DATABASE_URL:-}}" ] || exit 5
    npm run -s db:check >/dev/null 2>&1 || exit 6
    exit 0
  )
}

schema_rc=0
schema_check || schema_rc=$?
case "${schema_rc}" in
  0) ;;
  4) echo "[deploy] schema check skipped: drizzle-kit not installed (production install)" ;;
  5) echo "[deploy] schema check skipped: no database URL available" ;;
  6) echo "[deploy] WARNING: schema drift detected; there may be pending migrations." ;;
  *) echo "[deploy] schema check skipped: could not run (exit ${schema_rc})" ;;
esac

cd "${REPO_DIR}"
pm2 reload "${SERVICE_NAME}" --update-env || pm2 start "${PM2_ECOSYSTEM}" --update-env

check_port_health() {
  local port="$1"
  local body
  body="$(curl -fsS "http://127.0.0.1:${port}${HEALTH_PATH}")" || return 1
  [[ "${body}" == *'"status":"ok"'* ]] || return 1
  [[ "${body}" == *'"status":"starting"'* ]] && return 1
  return 0
}

for port in ${PORTS}; do
  ready=0
  for ((attempt=1; attempt<=MAX_ATTEMPTS; attempt++)); do
    if check_port_health "${port}"; then
      ready=1
      echo "[deploy] health ok on ${port}"
      break
    fi
    sleep "${SLEEP_SECONDS}"
  done
  if [[ "${ready}" -ne 1 ]]; then
    echo "[deploy] ERROR: health check failed on ${port}${HEALTH_PATH}" >&2
    exit 1
  fi
done

echo "[deploy] deploy complete"
