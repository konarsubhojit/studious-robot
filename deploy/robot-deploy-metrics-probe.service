[Unit]
Description=Probe robot-signal metrics after deployment
After=robot-signal.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/robot-signal/env
EnvironmentFile=/etc/robot-metrics.env
ExecStart=/usr/local/bin/robot-deploy-metrics-probe.sh
TimeoutStartSec=25
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
