{
  "name": "studious-robot-server",
  "version": "0.1.0",
  "description": "Signaling server (Express + Socket.IO) for studious-robot.",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
