{
  "name": "wetalk-server",
  "version": "0.1.0",
  "description": "Signaling server (Express + Socket.IO) for WeTalk.",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "cd .. && eslint --config server/eslint.config.js server shared",
    "dev": "node --watch src/index.ts",
    "test": "node --experimental-test-module-mocks --test \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:generate:named": "drizzle-kit generate --name",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:backfill-conversations": "node scripts/backfill-conversation-index.ts",
    "db:backfill-body-lower": "node scripts/backfill-message-body-lower.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
