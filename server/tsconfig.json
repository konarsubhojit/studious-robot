{
  // TypeScript migration complete - see ../docs/history/TYPESCRIPT_MIGRATION.md.
  //
  // Every source file is TypeScript (`.ts`/`.tsx`), so the whole project is
  // strict-checked by default. Run `npm run typecheck` (also enforced in CI)
  // after adding or changing a file.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "db/**/*.ts",
    "test/**/*.ts",
    "drizzle.config.ts",
    "../shared/**/*.ts"
  ],
  "exclude": ["node_modules", "../shared/node_modules"]
}
