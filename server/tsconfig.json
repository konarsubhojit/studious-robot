{
  // TypeScript migration complete - see TYPESCRIPT_MIGRATION.md.
  //
  // Every `.js` file in this project is annotated, so `checkJs` is on and new
  // files are strict-checked by default. Run `npm run typecheck` (also enforced
  // in CI) after adding or changing a file.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "db/**/*.ts",
    "test/**/*.ts",
    "drizzle.config.ts",
    "../shared/**/*.ts"
  ],
  "exclude": ["node_modules", "../shared/node_modules"]
}
