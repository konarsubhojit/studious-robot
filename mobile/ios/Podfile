# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'StudiousRobot' do
  config = use_native_modules!

  # Crash reporting (@sentry/react-native, see docs/crash-reporting-decision.md)
  # needs no explicit pod of its own: `use_native_modules!` above autolinks
  # RNSentry from node_modules, and its sentry-cocoa xcframework is fetched
  # from a public GitHub release at `pod install` time. No Sentry credentials
  # are involved, so this target installs and builds without them — the DSN is
  # a build-time env var inlined into the JS bundle (see babel.config.js), and
  # the symbol/source-map upload scripts are only added once an
  # `ios/sentry.properties` exists, mirroring how Android applies Sentry's
  # Gradle integration only when `android/sentry.properties` is present.

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
