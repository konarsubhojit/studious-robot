<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource shrinking (enabled for release builds in app/build.gradle) keeps only
  the resources it can see referenced from code, the manifest or other
  resources. Anything resolved at runtime by name through
  `Resources.getIdentifier()` is invisible to it and is dropped with no
  build-time error - the failure only shows on device.

  The file is deliberately *not* called `keep.xml`: React Native's bundle step
  generates its own `res/raw/keep.xml` (for the drawables it extracts from JS)
  into the generated resources folder, which wins the resource merge and would
  silently replace this one. The shrinker reads `tools:keep` from every raw XML
  resource, so a distinct name keeps both sets of rules.

  - @drawable/ic_notification is looked up by name by react-native-webrtc's
    MediaProjectionNotification; without it `startForeground` fails and screen
    sharing silently stops working.
  - The google-services plugin generates the @string values below from
    google-services.json and Play Services reads them by name through
    StringResourceValueReader, so dropping them breaks Firebase initialisation
    (push notifications and Google sign-in). They only exist in
    FCM-configured builds; listing absent resources here is harmless.
-->
<resources
    xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_notification,@string/google_app_id,@string/gcm_defaultSenderId,@string/google_api_key,@string/google_crash_reporting_api_key,@string/google_storage_bucket,@string/project_id,@string/firebase_database_url,@string/default_web_client_id" />
